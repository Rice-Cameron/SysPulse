<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SysPulse.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="SysPulse.Desktop.Views.DeleteAllConfirmationModal"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsDeleteAllModalOpen}">

    <Grid Background="#bb000000">
        <Border Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="460" BorderBrush="{DynamicResource SysPulseDangerBrush}" BorderThickness="1">
            <StackPanel Spacing="16">
                <TextBlock Text="Delete All Snapshots" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"/>
                <TextBlock Text="Are you sure you want to delete all recorded snapshots? This will permanently remove all historical logs from the database. This action cannot be undone."
                           FontSize="12" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
                    <Button Command="{Binding CancelDeleteAllSnapshotsCommand}"
                            Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" CornerRadius="8" Padding="16,8">
                        <TextBlock Text="Cancel" FontSize="12"/>
                    </Button>
                    <Button Command="{Binding ConfirmDeleteAllSnapshotsCommand}"
                            Background="{DynamicResource SysPulseDangerBrush}" Foreground="White" CornerRadius="8" Padding="16,8">
                        <TextBlock Text="Delete All" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
