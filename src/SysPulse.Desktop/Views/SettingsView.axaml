<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SysPulse.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="SysPulse.Desktop.Views.SettingsView"
             x:DataType="vm:MainViewModel">

    <ScrollViewer Margin="0,10,0,0">
        <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">
            
            <!-- SECTION 1: AUTO SNAPSHOT CONFIGURATION -->
            <Border Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="AUTOMATIC DATABASE SNAPSHOTS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"/>
                    <TextBlock Text="Configure periodic background recording of system telemetry metrics to the active database."
                               FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}" TextWrapping="Wrap"/>

                    <!-- Toggle Enable / Disable -->
                    <Border Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" CornerRadius="8" Padding="14,10">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Enable Auto Snapshots" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"/>
                                <TextBlock Text="When enabled, SysPulse will capture snapshots periodically based on the interval below."
                                           FontSize="11" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PendingIsAutoSnapshotEnabled}" 
                                          OnContent="Enabled" OffContent="Disabled" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Interval Configuration (Visible when enabled) -->
                    <Border Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" CornerRadius="8" Padding="16" 
                            IsVisible="{Binding PendingIsAutoSnapshotEnabled}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Time Between Snapshots" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SysPulseTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PendingAutoSnapshotIntervalMinutes, StringFormat='{}{0} Minute(s)'}" 
                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SysPulseCpuBrush}"/>
                            </Grid>

                            <!-- Slider -->
                            <Slider Minimum="1" Maximum="60" Value="{Binding PendingAutoSnapshotIntervalMinutes}" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4"/>

                            <!-- Quick Preset Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Presets:" FontSize="11" Foreground="{DynamicResource SysPulseTextSubduedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Command="{Binding SetIntervalPresetCommand}" CommandParameter="1"
                                        Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="1 Min" FontSize="11"/>
                                </Button>
                                <Button Command="{Binding SetIntervalPresetCommand}" CommandParameter="5"
                                        Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="5 Min" FontSize="11"/>
                                </Button>
                                <Button Command="{Binding SetIntervalPresetCommand}" CommandParameter="10"
                                        Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="10 Min" FontSize="11"/>
                                </Button>
                                <Button Command="{Binding SetIntervalPresetCommand}" CommandParameter="15"
                                        Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="15 Min" FontSize="11"/>
                                </Button>
                                <Button Command="{Binding SetIntervalPresetCommand}" CommandParameter="30"
                                        Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="30 Min" FontSize="11"/>
                                </Button>
                                <Button Command="{Binding SetIntervalPresetCommand}" CommandParameter="60"
                                        Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="60 Min" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Disabled State Notice -->
                    <Border Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" CornerRadius="8" Padding="14,10"
                            IsVisible="{Binding !PendingIsAutoSnapshotEnabled}">
                        <TextBlock Text="Auto snapshots are disabled. No background logs will be written to the database. Manual snapshots can still be taken via [+ Snapshot DB]."
                                   FontSize="11" Foreground="{DynamicResource SysPulseSwapBrush}" TextWrapping="Wrap"/>
                     </Border>
                </StackPanel>
            </Border>

            <!-- SECTION 2: METRICS UPDATE FREQUENCY -->
            <Border Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="METRICS UPDATE FREQUENCY" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"/>
                            <TextBlock Text="Choose how frequently live telemetry (CPU, RAM, disks, network, and processes) is polled."
                                       FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PendingMetricsUpdateIntervalDisplay, StringFormat='Pending: {0}'}" 
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SysPulseCpuBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Standard Interval Dropdown Selector -->
                    <Border Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" CornerRadius="8" Padding="16">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="Select Interval:" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SysPulseTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding IntervalPresetNames}" 
                                      SelectedItem="{Binding SelectedIntervalPresetName}"
                                      HorizontalAlignment="Left" Width="220"
                                      Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"
                                      CornerRadius="8" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Custom Duration Input -->
                    <Border Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" CornerRadius="8" Padding="14,12">
                        <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *">
                            <TextBlock Grid.Column="0" Text="Custom Duration:" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SysPulseTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding CustomIntervalValueText}" Width="70"
                                     Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextPrimaryBrush}" CornerRadius="6" FontSize="12"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding CustomUnitOptions}"
                                      SelectedItem="{Binding SelectedCustomUnit}"
                                      Width="110" Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"
                                      CornerRadius="6" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="3" Command="{Binding ApplyCustomIntervalCommand}"
                                    Background="{DynamicResource SysPulseAccentBrush}" Foreground="White" CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                                <TextBlock Text="Set Custom" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION 3: APPEARANCE & THEME -->
            <Border Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="APPEARANCE &amp; DESKTOP THEME" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"/>
                            <TextBlock Text="Toggle between default dark mode, light mode, or synchronize dynamically with your active desktop theme."
                                       FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PendingThemeMode, StringFormat='Pending: {0}'}" 
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SysPulseCpuBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Theme Selection Cards -->
                    <Grid ColumnDefinitions="*, *, *">
                        <!-- Dark Mode (Default) -->
                        <Button Grid.Column="0" Command="{Binding SelectThemeModeCommand}" CommandParameter="Dark"
                                Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" 
                                BorderBrush="{DynamicResource SysPulseInputBackgroundBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,6,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Dark Mode (Default)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"/>
                                <TextBlock Text="Obsidian command center palette" FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Light Mode -->
                        <Button Grid.Column="1" Command="{Binding SelectThemeModeCommand}" CommandParameter="Light"
                                Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" 
                                BorderBrush="{DynamicResource SysPulseInputBackgroundBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="3,0,3,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Light Mode" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"/>
                                <TextBlock Text="High-contrast crisp daylight palette" FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Omarchy Theme -->
                        <Button Grid.Column="2" Command="{Binding SelectThemeModeCommand}" CommandParameter="Omarchy"
                                Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" 
                                BorderBrush="{DynamicResource SysPulseInputBackgroundBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="6,0,0,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Omarchy Theme" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"/>
                                <TextBlock Text="{Binding OmarchyThemeDisplayName, StringFormat='Sync: {0}'}" FontSize="11" Foreground="{DynamicResource SysPulseCpuBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Desktop Environment Status Info -->
                    <Border Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" CornerRadius="8" Padding="12,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding OmarchyThemeDisplayName, StringFormat='Desktop Environment Detected: {0}'}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SysPulseSuccessBrush}"
                                       IsVisible="{Binding IsOmarchyAvailable}"/>
                            <TextBlock Text="Desktop theme syncing is active. Changing your system theme will hot-reload colors in real-time."
                                       FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"
                                       IsVisible="{Binding IsOmarchyAvailable}"/>
                            <TextBlock Text="Desktop theme files not detected on this machine. Selecting Omarchy theme will use standard dark mode."
                                       FontSize="11" Foreground="{DynamicResource SysPulseSwapBrush}"
                                       IsVisible="{Binding !IsOmarchyAvailable}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION 4: DATABASE BACKEND INFO -->
            <Border Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="DATABASE &amp; CENTRALIZED LOGGING" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"/>
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,4">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,10,10">
                            <TextBlock Text="ACTIVE PROVIDER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                            <TextBlock Text="{Binding DatabaseProviderName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SysPulseCpuBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,10">
                            <TextBlock Text="LOCAL SERVER HOSTNAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                            <TextBlock Text="{Binding Hostname}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SysPulseTextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock Text="CENTRALIZED LOGGING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                            <TextBlock Text="Supported (MySQL multi-server with host indexing)" FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Text="RECORDED SNAPSHOTS COUNT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                            <TextBlock Text="{Binding TotalSnapshotsRecorded}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SysPulseSuccessBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Button Command="{Binding RequestDeleteAllSnapshotsCommand}"
                            Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseDangerBrush}" CornerRadius="8" Padding="14,8"
                            HorizontalAlignment="Left" Margin="0,4,0,0">
                        <TextBlock Text="Delete All Snapshots..." FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- SECTION 5: ACTIONS & PERSISTENCE -->
            <Border Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{Binding SaveSettingsCommand}" 
                                Background="{DynamicResource SysPulseAccentBrush}" Foreground="White" CornerRadius="8" Padding="18,8">
                            <TextBlock Text="Save Settings" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Command="{Binding DiscardSettingsCommand}" 
                                IsEnabled="{Binding HasUnsavedSettingsChanges}"
                                Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" CornerRadius="8" Padding="14,8">
                            <TextBlock Text="Discard Changes" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding ResetSettingsCommand}" 
                                Background="{DynamicResource SysPulseInputBackgroundBrush}" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" CornerRadius="8" Padding="14,8">
                            <TextBlock Text="Reset to Defaults" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Unsaved changes pending. Click 'Save Settings' to apply, or 'Discard Changes' to revert." 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SysPulseSwapBrush}"
                               IsVisible="{Binding HasUnsavedSettingsChanges}"/>
                    <TextBlock Text="{Binding SettingsStatusMessage}" FontSize="11" Foreground="{DynamicResource SysPulseSuccessBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
