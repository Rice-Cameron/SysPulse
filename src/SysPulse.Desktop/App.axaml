<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SysPulse.Desktop.App"
             xmlns:local="using:SysPulse.Desktop"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Default Dark Palette Brushes -->
        <SolidColorBrush x:Key="SysPulseWindowBackgroundBrush" Color="#13141f" />
        <SolidColorBrush x:Key="SysPulseCardBackgroundBrush" Color="#1c1d2d" />
        <SolidColorBrush x:Key="SysPulseCardSecondaryBackgroundBrush" Color="#24263a" />
        <SolidColorBrush x:Key="SysPulseInputBackgroundBrush" Color="#2a2c42" />
        <SolidColorBrush x:Key="SysPulseAccentBrush" Color="#3b82f6" />
        <SolidColorBrush x:Key="SysPulseTextPrimaryBrush" Color="#f8fafc" />
        <SolidColorBrush x:Key="SysPulseTextSecondaryBrush" Color="#cbd5e1" />
        <SolidColorBrush x:Key="SysPulseTextMutedBrush" Color="#94a3b8" />
        <SolidColorBrush x:Key="SysPulseTextSubduedBrush" Color="#64748b" />
        <SolidColorBrush x:Key="SysPulseSuccessBrush" Color="#10b981" />
        <SolidColorBrush x:Key="SysPulseCpuBrush" Color="#38bdf8" />
        <SolidColorBrush x:Key="SysPulseMemoryBrush" Color="#34d399" />
        <SolidColorBrush x:Key="SysPulseSwapBrush" Color="#fb923c" />
        <SolidColorBrush x:Key="SysPulseNetworkBrush" Color="#c084fc" />
        <SolidColorBrush x:Key="SysPulseDangerBrush" Color="#ef4444" />
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#2a2c42" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2a2c42" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2a2c42" />
        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#2a2c42" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1c1d2d" />
        <SolidColorBrush x:Key="TextControlBackground" Color="#2a2c42" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2a2c42" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2a2c42" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SysPulseTextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox /template/ Border#HighlightBackground">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource SysPulseTextSecondaryBrush}" />
        </Style>
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{DynamicResource SysPulseCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SysPulseTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SysPulseTextPrimaryBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SysPulseTextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SysPulseTextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SysPulseInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SysPulseAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Styles>
</Application>