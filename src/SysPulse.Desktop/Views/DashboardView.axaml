<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SysPulse.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="600"
             x:Class="SysPulse.Desktop.Views.DashboardView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">
        <!-- FOUR GLANCEABLE STAT CARDS -->
        <Grid Grid.Row="0" ColumnDefinitions="*, *, *, *" Margin="0,0,0,14">
            <!-- CPU Card -->
            <Border Grid.Column="0" Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,6,0">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="CPU USAGE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CoreCount, StringFormat='{}{0} Cores'}" FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"/>
                    </Grid>
                    <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0:F1}%'}" 
                               FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SysPulseCpuBrush}"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuUsagePercent}" 
                                 Height="8" CornerRadius="4" Foreground="{DynamicResource SysPulseCpuBrush}" Background="{DynamicResource SysPulseInputBackgroundBrush}"/>
                    <TextBlock Text="{Binding CpuClockGhz, StringFormat='Clock: {0:F2} GHz'}" 
                               FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Memory Card -->
            <Border Grid.Column="1" Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="16" Margin="4,0,4,0">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="MEMORY (RAM)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MemoryTotalGb, StringFormat='{}{0:F1} GB Total'}" FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"/>
                    </Grid>
                    <TextBlock Text="{Binding MemoryUsagePercent, StringFormat='{}{0:F1}%'}" 
                               FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SysPulseMemoryBrush}"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding MemoryUsagePercent}" 
                                 Height="8" CornerRadius="4" Foreground="{DynamicResource SysPulseMemoryBrush}" Background="{DynamicResource SysPulseInputBackgroundBrush}"/>
                    <TextBlock Text="{Binding MemoryUsedGb, StringFormat='Used: {0:F1} GB'}" 
                               FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Swap Memory Card -->
            <Border Grid.Column="2" Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="16" Margin="4,0,4,0">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="SWAP MEMORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SwapTotalGb, StringFormat='{}{0:F1} GB Total'}" FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"/>
                    </Grid>
                    <TextBlock Text="{Binding SwapUsagePercent, StringFormat='{}{0:F1}%'}" 
                               FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SysPulseSwapBrush}"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SwapUsagePercent}" 
                                 Height="8" CornerRadius="4" Foreground="{DynamicResource SysPulseSwapBrush}" Background="{DynamicResource SysPulseInputBackgroundBrush}"/>
                    <TextBlock Text="{Binding SwapUsedGb, StringFormat='Used: {0:F1} GB'}" 
                               FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Network Card -->
            <Border Grid.Column="3" Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="16" Margin="6,0,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="NETWORK THROUGHPUT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                    <ItemsControl ItemsSource="{Binding NetworkInterfaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:NetworkItemViewModel">
                                <StackPanel Margin="0,2">
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding InterfaceName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SysPulseTextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DownloadText, StringFormat='In: {0}'}" FontSize="11" Foreground="{DynamicResource SysPulseCpuBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding UploadText, StringFormat='Out: {0}'}" FontSize="11" Foreground="{DynamicResource SysPulseNetworkBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DETAILED SPLIT PANES -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *">
            <!-- Left: Per-Core & Drives -->
            <Grid Grid.Column="0" RowDefinitions="*, *" Margin="0,0,6,0">
                <!-- Per-Core CPU -->
                <Border Grid.Row="0" Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,6">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="PER-CORE CPU UTILIZATION" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextMutedBrush}" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding PerCoreUsage}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="55, *, 45" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="Core" FontSize="11" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding}" 
                                                         Height="6" CornerRadius="3" Foreground="{DynamicResource SysPulseCpuBrush}" Background="{DynamicResource SysPulseInputBackgroundBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding, StringFormat='{}{0:F0}%'}" FontSize="11" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Mounted Drives -->
                <Border Grid.Row="1" Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,6,0,0">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="MOUNTED DRIVES &amp; DISK USAGE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextMutedBrush}" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DriveItemViewModel">
                                        <Border Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <Grid RowDefinitions="Auto, Auto">
                                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding MountPoint}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Format, StringFormat='({0})'}" FontSize="11" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource SysPulseTextMutedBrush}"/>
                                                </Grid>
                                                <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding UsagePercent}"
                                                             Height="6" CornerRadius="3" Foreground="{DynamicResource SysPulseSwapBrush}" Background="{DynamicResource SysPulseInputBackgroundBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Top Processes -->
            <Border Grid.Column="1" Background="{DynamicResource SysPulseCardBackgroundBrush}" CornerRadius="12" Padding="16" Margin="6,0,0,0">
                <Grid RowDefinitions="Auto, Auto, *">
                    <TextBlock Grid.Row="0" Text="TOP PROCESSES BY MEMORY USAGE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextMutedBrush}" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="{DynamicResource SysPulseCardSecondaryBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="60, *, 90">
                            <TextBlock Grid.Column="0" Text="PID" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                            <TextBlock Grid.Column="1" Text="PROCESS NAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                            <TextBlock Grid.Column="2" Text="MEMORY (MB)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SysPulseTextSubduedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ProcessItemViewModel">
                                    <Border Padding="10,5" Margin="0,1" CornerRadius="4">
                                        <Grid ColumnDefinitions="60, *, 90">
                                            <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource SysPulseTextSubduedBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SysPulseTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding MemoryMB, StringFormat='{}{0:F1} MB'}" FontSize="11" Foreground="{DynamicResource SysPulseMemoryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
